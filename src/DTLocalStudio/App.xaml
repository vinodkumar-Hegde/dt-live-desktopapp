<Application x:Class="DTLocalStudio.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnMainWindowClose">
 <Application.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#FFFFFF"/>
   <Setter Property="Foreground" Value="#203650"/>
   <Setter Property="BorderBrush" Value="#D1DCE9"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="12,8"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="7"/><Setter Property="BorderBrush" Value="#CCD9E6"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="6"/></Style>
 </Application.Resources>
</Application>
